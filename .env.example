TUENEL_VERSION=latest

POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
DATABASE_URL=

GATEWAY_CREDENTIALS_MASTER_KEY=
WEB_SESSION_SECRET=
TUENEL_DEPLOYMENT_MODE=standalone
AUTH_REGISTRATION_MODE=invite_only
AUTH_INVITATION_DELIVERY=manual
# SHA-256 hex digest of a one-time tb_ bootstrap token.
AUTH_BOOTSTRAP_TOKEN_HASH=
RESEND_API_KEY=
RESEND_FROM=Tuenel <noreply@example.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000
# OpenAI-compatible base URL shown in the console. Defaults to GATEWAY_PORT.
GATEWAY_PUBLIC_URL=

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ADMIN_ROLE=gateway_admin

UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=
GATEWAY_MODEL_ALIAS=gateway-default

GATEWAY_PORT=4060
GATEWAY_WEB_PORT=4050
DEFAULT_VIRTUAL_KEY_DAILY_TOKENS=100000
RUST_LOG=info
MCP_ENABLED=true
