POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me

# Docker Compose defaults use postgres/mock-provider service names.
DATABASE_URL=postgres://gateway:change-me@postgres:5432/gateway
REDIS_URL=redis://redis:6379
GATEWAY_CREDENTIALS_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
OIDC_ISSUER=http://mock-provider:4010
OIDC_AUDIENCE=gateway
OIDC_JWKS_URL=http://mock-provider:4010/jwks
OIDC_ADMIN_ROLE=gateway_admin
UPSTREAM_BASE_URL=http://mock-provider:4010/v1
UPSTREAM_API_KEY=
UPSTREAM_MODEL=mock-model
GATEWAY_MODEL_ALIAS=gateway-default
GATEWAY_BIND_ADDR=0.0.0.0:8080
GATEWAY_API_URL=http://localhost:8080
# At least 32 random characters; used only by gateway-web to encrypt its HttpOnly cookie.
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
GATEWAY_WEB_PORT=3000
REQUEST_TIMEOUT_SECONDS=120
MAX_BODY_BYTES=1048576
MAX_OUTPUT_TOKENS=4096
DEFAULT_OUTPUT_TOKENS=1024
DEFAULT_VIRTUAL_KEY_DAILY_TOKENS=100000
QUOTA_RESERVATION_TTL_SECONDS=300
INPUT_COST_PER_MILLION_USD=0
OUTPUT_COST_PER_MILLION_USD=0
RUST_LOG=info
MCP_ENABLED=true
MCP_DISCOVERY_CACHE_SECONDS=300
MCP_MAXIMUM_SCHEMA_BYTES=262144
MCP_DEFAULT_TOOL_TIMEOUT_SECONDS=30
MCP_MAXIMUM_RESPONSE_BYTES=1048576
MCP_ALLOW_PRIVATE_HTTP_ENDPOINTS=true
MCP_ALLOWED_STDIO_COMMANDS=node,python,uvx
SECURITY_ENABLED=true
APPROVAL_ENABLED=true
APPROVAL_DEFAULT_EXPIRATION_SECONDS=900
