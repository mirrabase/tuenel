# Public DNS A/AAAA records must point to this Docker host.
COMPOSE_PROJECT_NAME=tuenel
TUENEL_WEB_DOMAIN=
TUENEL_API_DOMAIN=
ACME_EMAIL=

# Pin a published release. Do not use latest in production.
TUENEL_VERSION=

POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
# URL-encode POSTGRES_PASSWORD before placing it in this URL.
DATABASE_URL=

# Generate with: openssl rand -base64 32
GATEWAY_CREDENTIALS_MASTER_KEY=
# Generate with: openssl rand -hex 32
WEB_SESSION_SECRET=

# Optional RS256 OIDC. Set all three values or leave all three empty.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ADMIN_ROLE=gateway_admin

# Optional environment-managed default provider. Set URL and model together.
# Providers can also be configured after login in the web console.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=
GATEWAY_MODEL_ALIAS=gateway-default

DEFAULT_VIRTUAL_KEY_DAILY_TOKENS=100000
RUST_LOG=info
MCP_ENABLED=true
TRAEFIK_LOG_LEVEL=INFO
